# Vindeshi Express — environment template.
#
# The real values live in .env.local, which is written by `neon link` / `neon deploy`
# and is gitignored. Never commit it (CLAUDE.md §4).
#
# Copy this file to .env.local only if you are not using the Neon CLI.

# Neon branch this checkout points at. `production` is the linked branch; use a
# `neon checkout <name>` scratch branch for anything destructive or untested.
NEON_BRANCH=production

# Pooled endpoint — application queries.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct endpoint — Prisma Migrate and Introspect only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── Sign-in (Phase 7) ────────────────────────────────────────────────────────
#
# Names only. The real values NEVER go in this file — it is tracked, and this
# repository is public (CLAUDE.md §4). Put them in .env.local, which is
# gitignored, and in the Vercel project's Environment Variables.

# Signs the session cookie. Generate one, do not invent one:
#   npx auth secret        (writes it straight into .env.local)
# or: openssl rand -base64 33
AUTH_SECRET=

# From a Google Cloud OAuth 2.0 Client ID (type: Web application).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
# The path is fixed by Auth.js — /api/auth/callback/google — and a mismatch here
# is the single most common cause of redirect_uri_mismatch.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Not needed on Vercel: Auth.js trusts the host when VERCEL is set. Only set this
# if you run the production build somewhere else (Test.md §16 — an untrusted host
# returns no session at all, which looks exactly like a broken cookie).
# AUTH_URL=https://your-domain
