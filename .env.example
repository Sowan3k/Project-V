# Vindeshi Express — environment template.
#
# The real values live in .env.local, which is written by `neon link` / `neon deploy`
# and is gitignored. Never commit it (CLAUDE.md §4).
#
# Copy this file to .env.local only if you are not using the Neon CLI.

# Neon branch this checkout points at. `production` is the linked branch; use a
# `neon checkout <name>` scratch branch for anything destructive or untested.
NEON_BRANCH=production

# Pooled endpoint — application queries.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct endpoint — Prisma Migrate and Introspect only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
