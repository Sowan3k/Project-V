{
  "name": "vindeshi-express",
  "version": "0.0.0",
  "private": true,
  "description": "Bangladesh-first, community-maintained navigation and tracking platform for students pursuing higher education abroad.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "dotenv -e .env.test.local -- vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "spike:test": "vitest run --config vitest.spike.config.mts",
    "spike:gallery": "tsx spikes/renderer/gallery.ts",
    "prisma:enums": "tsx scripts/generate-prisma-enums.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:status": "dotenv -e .env.local -- prisma migrate status",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "db:objects": "dotenv -e .env.local -- node scripts/db-objects.mjs",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@neon/config": "1.1.0",
    "@neon/env": "1.1.6",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
